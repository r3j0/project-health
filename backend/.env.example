NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Generate a real value with npm run auth:secret; never use a shared default.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SAME_SITE=lax
# Comma-separated addresses/CIDRs of actual reverse proxies; empty trusts none.
TRUST_PROXY_CIDRS=
DATABASE_URL=postgresql://project_health:CHANGE_ME@127.0.0.1:15432/project_health?schema=public
TEST_DATABASE_URL=postgresql://project_health:CHANGE_ME@127.0.0.1:15432/project_health_test?schema=public
